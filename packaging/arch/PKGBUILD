# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>
# Builds the commit checked out in a local clone: HYPRHANDS_SRC points at it (default: the repo
# this file lives in), so a branch under test is packaged by checking it out there.
pkgname=hyprhands
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, safe hands on a Hyprland desktop for agent loops"
arch=('x86_64')
url="https://github.com/MasonRhodesDev/hyprhands"
license=('MIT')
depends=('gcc-libs' 'glibc' 'hyprland' 'at-spi2-core')
makedepends=('cargo' 'git')
options=('!lto' '!debug')
_src="${HYPRHANDS_SRC:-$(realpath "$startdir/../..")}"
source=("$pkgname::git+file://$_src#commit=$(git -C "$_src" rev-parse HEAD)")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "%s.r%s.g%s" "$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/hyprhands "$pkgdir/usr/bin/hyprhands"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
